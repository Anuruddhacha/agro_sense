/* Agriculture Sensor Dashboard - Dark green theme */

QWidget#mainWindow {
    background-color: #0f1a14;
    color: #e8f5e9;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 13px;
}

QScrollArea#dashboardScroll {
    background: transparent;
    border: none;
}

QFrame#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1b3d2f, stop:1 #0f2a1f);
    border: 1px solid #2e5c44;
    border-radius: 12px;
}

QLabel#appTitle {
    font-size: 26px;
    font-weight: 700;
    color: #c8f7d8;
}

QLabel#appSubtitle {
    font-size: 13px;
    color: #8fbf9f;
}

QLabel#connectionBadge {
    font-size: 14px;
    font-weight: 600;
    color: #ff8a65;
}

QLabel#connectionBadge[connected="true"] {
    color: #69f0ae;
}

QLabel#lastUpdate {
    font-size: 12px;
    color: #7a9e88;
}

QFrame#connectionPanel {
    background-color: #152820;
    border: 1px solid #2a4a38;
    border-radius: 10px;
}

QLabel#panelLabel {
    font-weight: 600;
    color: #a5d6b0;
}

QComboBox, QComboBox#portCombo {
    background-color: #1c3328;
    border: 1px solid #3d6b52;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8f5e9;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #4caf50;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1c3328;
    color: #e8f5e9;
    selection-background-color: #2e7d4f;
    border: 1px solid #3d6b52;
}

QPushButton#primaryButton {
    background-color: #2e7d4f;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3d9a62;
}

QPushButton#secondaryButton {
    background-color: #1c3328;
    color: #c8f7d8;
    border: 1px solid #3d6b52;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#secondaryButton:hover {
    border-color: #4caf50;
}

QPushButton#toggleButton {
    background-color: #1a3d52;
    color: #81d4fa;
    border: 1px solid #2a6a8a;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton#toggleButton:checked {
    background-color: #1565c0;
    color: white;
    border-color: #42a5f5;
}

QFrame#sectionFrame {
    background-color: #13241c;
    border: 1px solid #254a36;
    border-radius: 12px;
}

QLabel#sectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #7dcea0;
    letter-spacing: 0.5px;
}

QFrame#sensorCard {
    background-color: #1a2f24;
    border: 1px solid #2f5440;
    border-radius: 10px;
    min-height: 120px;
}

QFrame#sensorCard[statusLevel="warn"] {
    border-color: #ffb74d;
}

QFrame#sensorCard[statusLevel="error"] {
    border-color: #ef5350;
}

QFrame#sensorCard[statusLevel="info"] {
    border-color: #4fc3f7;
}

QLabel#cardIcon {
    font-size: 22px;
}

QLabel#cardTitle {
    font-size: 13px;
    font-weight: 600;
    color: #b2dfbc;
}

QLabel#cardStatus {
    font-size: 11px;
    font-weight: 700;
    color: #69f0ae;
    letter-spacing: 0.5px;
}

QFrame#sensorCard[statusLevel="warn"] QLabel#cardStatus {
    color: #ffb74d;
}

QFrame#sensorCard[statusLevel="error"] QLabel#cardStatus {
    color: #ef5350;
}

QFrame#sensorCard[statusLevel="info"] QLabel#cardStatus {
    color: #4fc3f7;
}

QLabel#cardValue {
    font-size: 36px;
    font-weight: 700;
    color: #e8f5e9;
}

QLabel#cardUnit {
    font-size: 16px;
    color: #7a9e88;
    padding-bottom: 6px;
    padding-left: 4px;
}

QLabel#cardSub {
    font-size: 12px;
    color: #7a9e88;
}

QScrollBar:vertical {
    background: #0f1a14;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #2e5c44;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMessageBox {
    background-color: #1a2f24;
}
